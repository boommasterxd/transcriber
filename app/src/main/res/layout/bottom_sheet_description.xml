<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/drag_handle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/api_key_eingeben"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/inputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/api_input_background_rounded_default"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="4dp"
                android:paddingTop="4dp"
                android:paddingRight="4dp"
                android:paddingBottom="4dp">

                <EditText
                    android:id="@+id/apiKeyEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:autofillHints="false"
                    android:background="@android:color/transparent"
                    android:hint="@string/api_key_hint"
                    android:inputType="textPassword"
                    android:maxLines="1"

                    android:textColor="@color/text_secondary"
                    android:textColorHint="@color/text_secondary"
                    android:textCursorDrawable="@color/samsung_blue" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/showHidePasswordButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:contentDescription="@string/transkription_teilen"
                        android:focusable="true"
                        android:foreground="@drawable/ripple_effect_oval"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/rounded_visibility_24" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/saveApiKeyButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:contentDescription="@string/transkription_teilen"
                        android:focusable="true"
                        android:foreground="@drawable/ripple_effect_oval"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/rounded_save_24" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/descriptionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/description"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
